{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/cron/notifications", "schedule": "0 6 * * *" },
    { "path": "/api/cron/auto-confirm", "schedule": "0 7 * * *" },
    { "path": "/api/cron/mature-earnings", "schedule": "0 8 * * *" },
    { "path": "/api/cron/expire-jobs", "schedule": "0 3 * * *" },
    { "path": "/api/cron/publish-reviews", "schedule": "0 4 * * *" },
    { "path": "/api/cron/cleanup", "schedule": "30 4 * * *" },
    { "path": "/api/cron/reconcile", "schedule": "0 5 * * *" }
  ],
  "functions": {
    "src/app/api/webhooks/paystack/route.ts": { "maxDuration": 30 },
    "src/app/api/cron/[task]/route.ts": { "maxDuration": 60 }
  }
}
