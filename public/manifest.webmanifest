{
  "name": "Hustle Street",
  "short_name": "Hustle St",
  "description": "Get things done. Find people who can. A location-based marketplace connecting you with skilled people nearby.",
  "id": "/?source=pwa",
  "start_url": "/home?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#FAF9F7",
  "theme_color": "#FF5A1F",
  "lang": "en-NG",
  "dir": "ltr",
  "categories": ["business", "productivity", "shopping"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Post a Job",
      "short_name": "Post",
      "description": "Say what you need done",
      "url": "/post?source=shortcut",
      "icons": [{ "src": "/icons/shortcut-post.png", "sizes": "96x96" }]
    },
    {
      "name": "Find Work",
      "short_name": "Work",
      "description": "See jobs near you",
      "url": "/discover?source=shortcut",
      "icons": [{ "src": "/icons/shortcut-work.png", "sizes": "96x96" }]
    },
    {
      "name": "Messages",
      "short_name": "Chat",
      "description": "Your conversations",
      "url": "/messages?source=shortcut",
      "icons": [{ "src": "/icons/shortcut-messages.png", "sizes": "96x96" }]
    },
    {
      "name": "Wallet",
      "short_name": "Wallet",
      "description": "Balance and earnings",
      "url": "/wallet?source=shortcut",
      "icons": [{ "src": "/icons/shortcut-wallet.png", "sizes": "96x96" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-home.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Jobs near you"
    },
    {
      "src": "/screenshots/desktop-discover.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Discover work across Lagos"
    }
  ]
}
