# ─────────────────────────────────────────────────────────────────────────────
#  HUSTLE STREET — environment contract
#
#  Copy to `.env.local` for development. NEVER commit a filled-in .env file.
#  Every variable below is validated at boot by `src/lib/config/env.ts`; the app
#  refuses to start rather than run with a half-configured payment or auth stack.
#
#  Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle and are
#  therefore PUBLIC. Never put a secret behind that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | staging | production
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (Postgres + Auth + Realtime + Storage) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security. Never expose to the browser, never
# import outside `src/lib/supabase/admin.ts`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection — used only by migration + seed scripts and the
# cron worker. Use the session pooler URL in serverless environments.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# ── Payments: Paystack ───────────────────────────────────────────────────────
# Use sk_test_/pk_test_ in development + staging, sk_live_/pk_live_ in prod.
# `src/lib/config/env.ts` refuses to boot production with test keys.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Optional: only set if you use a distinct webhook secret. Paystack signs with
# the secret key by default (HMAC-SHA512 over the raw body).
PAYSTACK_WEBHOOK_SECRET=

# Active payment provider. Adding a provider = implementing the PaymentProvider
# port in src/lib/payments/providers/ and registering it here.
PAYMENT_PROVIDER=paystack

# ── Maps (MapLibre GL + raster/vector tiles) ─────────────────────────────────
# Default is OpenStreetMap raster tiles which need no key but are NOT licensed
# for production traffic — swap for MapTiler/Protomaps/Mapbox before launch.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
NEXT_PUBLIC_MAP_STYLE_URL=
# Geocoding / address search provider (Nominatim is fine for dev only).
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org
GEOCODING_API_KEY=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: pnpm keys:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hustlestreet.ng

# ── Transactional email ──────────────────────────────────────────────────────
# console = log to stdout (development). resend | postmark = real delivery.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Hustle Street <no-reply@hustlestreet.ng>"

# ── SMS / WhatsApp (OTP + critical alerts) ───────────────────────────────────
# console = log to stdout (development). termii | twilio = real delivery.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=HustleSt

# ── Analytics ────────────────────────────────────────────────────────────────
# Events are always written to the internal `analytics_events` table. Setting a
# key additionally forwards them to PostHog.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# ── Background jobs ──────────────────────────────────────────────────────────
# Shared secret required by /api/cron/* so only the scheduler can invoke them.
CRON_SECRET=change-me-to-a-long-random-string

# ── Rate limiting ────────────────────────────────────────────────────────────
# memory = per-instance (dev / single node). postgres = shared across instances.
RATE_LIMIT_BACKEND=postgres
